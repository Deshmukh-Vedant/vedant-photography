# Vedant Photography Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# CORS (Frontend URL on Vercel)
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=https://vedant-photography.vercel.app

# Database Options:
# Option A: MySQL Connection URI (e.g., Aiven, PlanetScale, Railway)
# DATABASE_URL=mysql://root:password@localhost:3306/student

# Option B: Individual MySQL Parameters (default fallback is local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=vedant
DB_NAME=student
DB_SSL=false

# Option C: PostgreSQL (Render Managed PostgreSQL)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# JWT Authentication
JWT_SECRET=vedant_photography_super_secret_jwt_key_2026

# Optional: Cloudinary Object Storage for permanent user uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
