# ==============================================================
# Vedant Photography - Environment Configuration Reference
# ==============================================================

# --- BACKEND (Render) ---
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# CORS Origins (Comma-separated or frontend domain)
CLIENT_URL=https://vedant-photography.vercel.app
CORS_ORIGIN=*

# JWT Authentication Secret (Generate a strong random 32+ char string)
JWT_SECRET=replace_with_your_secure_random_jwt_secret_key_here

# Database Option 1: MySQL Connection String (Aiven, PlanetScale, Railway, CleverCloud)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:vedant@localhost:3306/student

# Database Option 2: Render Free Managed PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# DATABASE_URL=postgres://user:password@render-host.oregon-postgres.render.com/dbname

# Database Option 3: Individual MySQL Credentials (Local development fallback)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=vedant
DB_NAME=student
DB_SSL=false

# Optional: Cloudinary Object Storage for permanent cloud media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- FRONTEND (Vercel) ---
# Set this in Vercel Project Settings > Environment Variables:
# NEXT_PUBLIC_API_URL=https://vedant-photography-backend.onrender.com
